# ---------------------------------------------------------------------------
# ForgeAI Studio - backend configuration
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real keys.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
DB_PATH=./data/ide.sqlite
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# AI coding agent - local LLM
#
# provider:      ollama | openai-compatible
# baseUrl:       Ollama, e.g. http://127.0.0.1:11434
#                any OpenAI-compatible server, e.g. http://127.0.0.1:1234/v1
#                (the /v1 suffix is added automatically)
# model:         must be pulled/installed on that server
# apiKey:        only for openai-compatible servers that require one.
#                Read from the environment at runtime, never persisted.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.1
LLM_API_KEY=
