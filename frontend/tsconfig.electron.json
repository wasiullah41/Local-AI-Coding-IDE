{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./electron-dist",
    "rootDir": "./electron",
    "sourceMap": false
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["electron/**/*.d.ts"]
}
