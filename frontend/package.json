{
  "name": "@local-ide/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI-powered coding environment",
  "author": {
    "name": "ForgeAI Studio"
  },
  "type": "module",
  "main": "electron-dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.electron.json && shx mv electron-dist/main.js electron-dist/main.cjs && shx mv electron-dist/preload.js electron-dist/preload.cjs && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build",
    "build:electron": "tsc -p tsconfig.electron.json && shx mv electron-dist/main.js electron-dist/main.cjs && shx mv electron-dist/preload.js electron-dist/preload.cjs",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.forgeai.studio",
    "productName": "ForgeAI Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ForgeAI Studio"
    }
  },
  "dependencies": {
    "@local-ide/shared": "file:../shared",
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.3.0",
    "axios": "^1.7.2",
    "lucide-react": "^0.378.0",
    "monaco-editor": "0.55.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.2.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^30.1.1",
    "postcss": "^8.4.38",
    "shx": "^0.3.4",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
}
